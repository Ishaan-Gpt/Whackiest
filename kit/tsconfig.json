{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023"],
    "strict": true, "skipLibCheck": true, "allowImportingTsExtensions": true, "noEmit": true,
    "isolatedModules": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
